# ============================================================================
#  Certificates for the TAK listeners that check client certificates
#  (8443 Marti API, 8883 MQTT).
#
#  These ALWAYS use the OpenTAKServer CA, never Let's Encrypt: TAK clients
#  authenticate with client certificates issued by this CA, so the server
#  side of the handshake has to belong to the same PKI.
#
#  Enrollment (8446) does not use this file - it takes no client certificate,
#  so it can present Let's Encrypt. See 15-ots-tls-mode.sh.
#
#  Created automatically by OpenTAKServer on first start.
# ============================================================================

# CA used to verify client certificates
ssl_client_certificate  /app/ots/ca/ca.pem;

# OpenTAKServer server certificate
ssl_certificate         /app/ots/ca/certs/opentakserver/opentakserver.pem;
ssl_certificate_key     /app/ots/ca/certs/opentakserver/opentakserver.nopass.key;
