#******************************************************
#   Web UI - HTTPS
#   Port: 443
#
#   This is the only listener that can use a Let's Encrypt certificate.
#   The include below is written at container start by
#   15-ots-tls-mode.sh, based on OTS_TLS_MODE.
#******************************************************
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${OTS_FQDN};
    root /usr/share/nginx/html;

    # Docker's embedded DNS. Required because the proxy_pass targets below
    # use variables, which defers name resolution to request time and keeps
    # nginx from refusing to start if a backend is not up yet.
    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;

    set $upstream_ots ${OTS_ADDRESS};
    set $upstream_mtx ${MTX_ADDRESS};

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    include includes.d/webui_certificate;

    location = /health {
        access_log off;
        add_header Content-Type application/json;
        return 200 '{"status":"healthy"}';
    }

    #******************************************************
    #       OpenTAKServer API
    #******************************************************
    location /api {
        include includes.d/proxy_params;
        proxy_pass http://$upstream_ots;
    }

    location /Marti {
        include includes.d/proxy_params;
        proxy_http_version 1.1;
        proxy_pass http://$upstream_ots;
    }

    # Live updates for the map and dashboard.
    location /socket.io {
        include includes.d/proxy_params;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_pass http://$upstream_ots;
    }

    #******************************************************
    #       MediaMTX video
    #******************************************************
    location ~ ^/hls(/?)(.*)$ {
        include includes.d/proxy_params;
        proxy_pass http://$upstream_mtx:8888/$2$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;

        client_max_body_size 0;
    }

    location ~ ^/webrtc(/?)(.*)$ {
        include includes.d/proxy_params;
        proxy_pass http://$upstream_mtx:8889/$2$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect off;
    }

    #******************************************************
    #       Web UI (single page app)
    #******************************************************
    location / {
        try_files $uri $uri/ /index.html;
    }
}
