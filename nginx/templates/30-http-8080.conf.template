#******************************************************
#   Marti API - HTTP
#   Port: 8080
#
#   Unauthenticated TAK API access. Certificate enrollment is deliberately
#   blocked here; it belongs on port 8446 where TLS protects the password.
#******************************************************
server {
    listen 8080;
    server_name _;

    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;

    set $upstream_ots ${OTS_ADDRESS};

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    location /Marti/api/tls {
        return 404;
    }

    location /Marti {
        include includes.d/proxy_params;
        proxy_http_version 1.1;
        proxy_pass http://$upstream_ots;
    }
}
