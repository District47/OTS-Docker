#******************************************************
#   Certificate enrollment
#   Port: 8446
#
#   TAK clients hit this port with a username and password to be issued a
#   client certificate. No client certificate is required (that is the whole
#   point), so only the enrollment endpoint is exposed.
#
#   The certificate is chosen by 15-ots-tls-mode.sh: Let's Encrypt when it is
#   in use - so QR-code enrollment works without a trust store - otherwise the
#   OpenTAKServer certificate. Nothing here verifies client certificates, so
#   the OpenTAKServer CA is not needed on this port.
#******************************************************
server {
    listen 8446 ssl;
    server_name ${OTS_FQDN};

    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;

    set $upstream_ots ${OTS_ADDRESS};

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    include includes.d/enrollment_certificate;

    location / {
        return 403;
    }

    location /Marti/api/tls {
        include includes.d/proxy_params;
        proxy_http_version 1.1;
        proxy_pass http://$upstream_ots;
    }
}
