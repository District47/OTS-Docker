# ============================================================================
#  OpenTAKServer for Docker - configuration
# ============================================================================
#  Copy this file to ".env" and edit it, or just run setup.ps1 which will
#  generate a .env for you with secure random passwords.
#
#  IMPORTANT: OpenTAKServer reads these values ONLY on its very first start.
#  On first start it writes them into config.yml inside the ots_data volume,
#  and from then on config.yml wins. To change a setting later, use the
#  Settings page in the web UI, or run:  .\ots.ps1 config
# ============================================================================

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Pinned so that an image update never breaks a working install.
# See https://github.com/brian7704/OpenTAKServer/releases
OTS_VERSION=1.7.13

# The web UI image is only published under the "master" tag.
OTS_UI_VERSION=master

# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------
# The address TAK clients and browsers use to reach this server: a LAN IP
# (192.168.1.50), a hostname, or a public domain (tak.example.com).
# "_" means "match any hostname" and is fine for LAN-only use.
OTS_FQDN=_

# ---------------------------------------------------------------------------
# Web UI TLS
# ---------------------------------------------------------------------------
# self-signed  = use OpenTAKServer's own CA (default; browsers will warn)
# letsencrypt  = use a real certificate from Let's Encrypt
#
# This affects the WEB UI on port 443 only. The TAK ports (8443/8446/8883)
# always use the OpenTAKServer CA, because TAK clients authenticate against
# it with client certificates.
OTS_TLS_MODE=self-signed

# Only used when OTS_TLS_MODE=letsencrypt. Requires OTS_FQDN to be a real
# public domain pointed at this machine, with port 80 reachable.
LETSENCRYPT_EMAIL=

# ---------------------------------------------------------------------------
# Internet access (dynamic DNS)
# ---------------------------------------------------------------------------
# Only used by the "public" profile. Home connections get a new public IP
# periodically; this keeps your hostname pointing at the right one.
#
# Sign up free at https://www.duckdns.org - you pick a subdomain and it gives
# you a token. If your subdomain is "mytak", your server is mytak.duckdns.org
# and that is what OTS_FQDN should be set to.
#
# Set both up automatically with:  .\ots.ps1 go-public
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# How often nginx reloads to pick up a renewed certificate, in seconds.
OTS_NGINX_RELOAD_INTERVAL=21600

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Use letters and numbers only - this password is embedded in a connection URL.
POSTGRES_USER=ots
POSTGRES_DB=ots
POSTGRES_PASSWORD=CHANGEME

# ---------------------------------------------------------------------------
# Message broker (RabbitMQ / MQTT)
# ---------------------------------------------------------------------------
# Letters and numbers only.
RABBITMQ_USER=ots
RABBITMQ_PASSWORD=CHANGEME

# ---------------------------------------------------------------------------
# Docker network
# ---------------------------------------------------------------------------
# RabbitMQ needs a predictable IP, because OpenTAKServer authorises its MQTT
# auth callbacks by source address. Change these only if the subnet collides
# with another Docker network or with your LAN.
OTS_NETWORK_SUBNET=172.28.0.0/16
OTS_RABBITMQ_IP=172.28.0.10

# ---------------------------------------------------------------------------
# Certificate Authority
# ---------------------------------------------------------------------------
# "atakatak" is the password TAK clients expect for imported .p12 bundles.
# Only change this if you know what you are doing.
OTS_CA_PASSWORD=atakatak
OTS_CA_NAME=OpenTAKServer-CA

# ---------------------------------------------------------------------------
# Ports  (change these if something else on Windows already uses them)
# ---------------------------------------------------------------------------
# Web UI
OTS_HTTP_PORT=80
OTS_HTTPS_PORT=443

# Marti API for TAK clients
OTS_MARTI_HTTP_PORT=8080
OTS_MARTI_HTTPS_PORT=8443

# Automatic certificate enrollment
OTS_CERT_ENROLLMENT_PORT=8446

# MQTT over TLS (Meshtastic and other MQTT clients)
OTS_MQTT_PORT=8883

# Address the unencrypted ports bind to. 0.0.0.0 = reachable from the network,
# 127.0.0.1 = this machine only. Set these with:  .\ots.ps1 tls-only [on|all|off]
#
# TAK plaintext: 8080 (Marti over HTTP) and 8088 (CoT without TLS).
OTS_PLAINTEXT_BIND=0.0.0.0
# Video plaintext: RTSP, RTMP, HLS and WebRTC. Kept open by default - many
# cameras and hardware encoders cannot do RTSPS or RTMPS.
OTS_VIDEO_PLAINTEXT_BIND=0.0.0.0

# CoT streaming
OTS_TCP_COT_PORT=8088
OTS_SSL_COT_PORT=8089
OTS_UDP_COT_PORT=8087

# Video streaming (MediaMTX)
VIDEO_RTMP_PORT=1935
VIDEO_RTMPS_PORT=1936
VIDEO_RTP_PORT=8000
VIDEO_RTCP_PORT=8001
# SRTP/SRTCP - used instead of the two above when RTSPS is encrypted-only
VIDEO_SRTP_PORT=8004
VIDEO_SRTCP_PORT=8005
VIDEO_WEBRTC_UDP_PORT=8189
VIDEO_RTSPS_PORT=8322
VIDEO_RTSP_PORT=8554
VIDEO_HLS_PORT=8888
VIDEO_WEBRTC_PORT=8889
VIDEO_SRT_PORT=8890

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Maximum upload size for data packages.
CLIENT_MAX_BODY_SIZE=512M

# Container timezone, e.g. America/New_York. UTC is recommended.
TZ=UTC
